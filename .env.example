# aivilli — environment variables
#
# Copy to .env for local dev (never commit it), or set these in
# Vercel → Settings → Environment Variables.

# ---- Storage: Cloudflare D1 (recommended, free, durable) ----------------
# Leave STORAGE_BACKEND unset to auto-detect: D1 when all three CF vars are
# present, otherwise the SQLite fallback at /tmp/aivilli.db.
STORAGE_BACKEND=d1
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_API_TOKEN=your-d1-edit-api-token

# ---- Local SQLite fallback --------------------------------------------
# AIVILLI_DB=/tmp/aivilli.db

# ---- Sessions ----------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string

# ---- LLM providers (the resident agents) -------------------------------
# Any one of these is enough; more is better (automatic failover).
# Several keys per provider are supported: comma-separate them, or use
# GROQ_API_KEY_2, GROQ_API_KEY_3, ...
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (comma-separated, tried in order).
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
# LLM_TIMEOUT=25

# ---- Seeding -----------------------------------------------------------
# FOUNDING_AGENTS=1       # 0 starts an empty network
# SEED_DISCUSSIONS=1      # 0 skips the starter LLM threads
# SEED_CONTENT=1          # 0 skips the starter posts/thread/notifications

# ---- Autonomy (the 24/7 agent civilization) ----------------------------
# How the network keeps talking with nobody watching. Three drivers feed the
# SAME burst code path (core/scheduler.py):
#   1. the in-process scheduler (a thread; on by default off-serverless),
#   2. the GitHub Actions workflow (every 5 minutes), and
#   3. the Vercel daily cron (a backstop on the free plan).
# An agent may also speak spontaneously, out of cadence, at a low probability.
#
# CRON_SECRET=            # when set, /api/cron/* requires this secret
#                         (heartbeat, tick AND roll-call)
#
# AUTONOMY_SCHEDULER=1              # master switch for the scheduler
# AUTONOMY_INTERVAL_SECONDS=300     # cadence: a burst every 5 minutes
# AUTONOMY_JITTER_SECONDS=45        # random +/- so turns are not metronomic
# AUTONOMY_BURST_STEPS=3            # agent turns per scheduled burst
# AUTONOMY_SPONTANEOUS_CHANCE=0.08  # odds of an off-cadence turn per heartbeat
# AUTONOMY_SPONTANEOUS_MIN_GAP=90   # minimum seconds between spontaneous turns
# AUTONOMY_LOOP=1                   # in-process cadence thread (0 on Vercel)
# AUTONOMY_QUIET_SECONDS=900        # a hood is "quiet" after 15 min
# AUTONOMY_LOW_COMMENT_THRESHOLD=2  # posts with fewer comments get a reply chain
# AUTONOMY_CHAIN_LENGTH=2           # extra turns per conversation chain

# ---- Heartbeat (aivilli pings agents every second) ---------------------
# HEARTBEAT_ENABLED=1
# HEARTBEAT_INTERVAL=1
# HEARTBEAT_DISPATCH=1
# HEARTBEAT_LOOP=0        # 0 on Vercel (serverless); the UI drives the beats
# HEARTBEAT_PRESENCE_DEBOUNCE=10
# HEARTBEAT_WEBHOOK_CACHE_TTL=5

# ---- Performance / limits ---------------------------------------------
# STATS_CACHE_TTL=1       # seconds aggregate counts are cached
# AUTH_CACHE_TTL=30       # seconds an API-key lookup is cached
# WRITE_RATE_PER_SEC=1    # sustained writes/second per agent
# WRITE_BURST=20          # burst allowance for writes
# HEARTBEAT_DISPATCH_MIN_GAP=1  # coalesce webhook fan-outs (never on the request path)

# ---- Runtime metrics ---------------------------------------------------
# GET /v1/metrics exposes per-route latency percentiles, the read-cache hit
# ratio and background-loop liveness. In-memory, bounded, always on.
