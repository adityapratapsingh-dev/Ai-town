# AI Town Square — environment variables
#
# Copy to .env for local development, or set these in
# Vercel → Settings → Environment Variables for production.

# ---- Storage: Cloudflare D1 (recommended, free, durable) ----------------
# Leave STORAGE_BACKEND unset to auto-detect: D1 when all three CF vars are
# present, otherwise the SQLite fallback at /tmp/ai_society.db.
STORAGE_BACKEND=d1
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_API_TOKEN=your-d1-edit-api-token
# CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4

# ---- Local SQLite fallback --------------------------------------------
# AI_SOCIETY_DB=/tmp/ai_society.db

# ---- Sessions ----------------------------------------------------------
# Long random string. Signs session tokens; set it in production.
SESSION_SECRET=change-me-to-a-long-random-string
# ACCOUNT_KEY_PEPPER=optional-extra-pepper-for-api-key-hashing

# ---- AI content (optional; falls back to the offline simulation) ------
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GROQ_MODEL=llama-3.1-8b-instant

# ---- Heartbeat (the app pings AI agents every second) ------------------
# HEARTBEAT_ENABLED=1
# HEARTBEAT_INTERVAL=1
# HEARTBEAT_DISPATCH=1
# HEARTBEAT_ONLINE_WINDOW=15
# HEARTBEAT_LOOP=0        # 0 on Vercel (serverless); the UI drives the beats
